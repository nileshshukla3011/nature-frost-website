# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the value below.
# `.env.local` is git-ignored, so your key never ends up in version control.
# ---------------------------------------------------------------------------

# Web3Forms access key — this is what makes the contact form deliver email.
#
# How to get it (free, 30 seconds, no account needed):
#   1. Go to https://web3forms.com
#   2. Enter the address you want enquiries delivered to: Naturefrost25@gmail.com
#   3. The access key arrives in that inbox
#   4. Paste it below, then rebuild the site (`npm run build`)
#
# NEXT_PUBLIC_ variables are baked in at BUILD time, so a rebuild is required
# after changing this. Until it is set, the contact form falls back to opening
# the visitor's own email app with the enquiry pre-filled.
NEXT_PUBLIC_WEB3FORMS_KEY=
